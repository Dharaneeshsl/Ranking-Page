# =============================================================================
# Ranking Platform - environment variables
# Copy to .env and fill in real values:  cp .env.example .env
# =============================================================================

# --- Runtime mode ------------------------------------------------------------
# development | production  (production disables /api/docs & enforces config)
ENVIRONMENT=production

# --- Security -----------------------------------------------------------------
# Generate a strong random key, e.g.:  openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-32

# --- MongoDB (docker-compose seeds these into the container) -----------------
MONGO_INITDB_ROOT_USERNAME=ranking
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-strong-mongo-password
DATABASE_NAME=ranking_db
# For Atlas/cloud: MONGODB_URI is built from the two vars above for local
# compose; use a real mongodb+srv:// URI directly in MONGODB_URI if you manage
# the DB yourself (set MONGODB_URI=... and leave compose defaults).
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ranking_db
# MONGODB_TLS_CA=/path/to/ca.pem   # only if your provider needs a CA bundle

# --- Admin bootstrap account (created on first startup) ----------------------
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password-12chars
ADMIN_NAME=Admin User

# --- Frontend / CORS ---------------------------------------------------------
# Comma separated list of allowed browser origins (no trailing slash).
# Over HTTPS set COOKIE_SECURE=1.
FRONTEND_URLS=http://localhost:8080
COOKIE_SECURE=0
WEB_PORT=8080

# --- Sessions ----------------------------------------------------------------
SESSION_EXPIRE_MINUTES=1440
SESSION_REMEMBER_MINUTES=43200

# --- Rate limiting (per IP, per minute) --------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_PER_MINUTE=300

# --- Optional tooling --------------------------------------------------------
# Uncomment to launch the Mongo admin UI alongside:  docker compose --profile tools up
# MONGO_EXPRESS_USER=replace-with-your-own-value
# MONGO_EXPRESS_PASSWORD=replace-with-your-own-value

# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY (running without Docker)
# -----------------------------------------------------------------------------
# ENVIRONMENT=development
# MONGODB_URI=mongodb://localhost:27017
# DATABASE_NAME=ranking_page_dev
# MOCK_DB=0            # set 1 for a zero-dependency in-memory Mongo demo
# FRONTEND_URLS=http://localhost:5173
